/target
/packaging/math-renderer/node_modules/
*.swp
*.swo
.idea/
.vscode/
.DS_Store

# Transient mise lockfiles; keep the committed mise.lock.
/.mise.lock.*

__pycache__/
*.py[cod]

# makepkg build output, when a PKGBUILD is built in place
packaging/aur/*/src/
packaging/aur/*/pkg/
packaging/aur/*/*.tar.gz
packaging/aur/*/*.pkg.tar.zst

/.pytest_cache/
/tests/e2e/.pytest_cache/

# Restored coding-agent skills (see skills-lock.json); the project's own
# skills under .agents/skills/qa-* are committed.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/qa-scenarios/
!/.agents/skills/qa-drive/
!/.agents/skills/qa-quality/
# Links to them for Claude Code; any other skill link is local.
/.claude/skills/*
!/.claude/skills/qa-scenarios
!/.claude/skills/qa-drive
!/.claude/skills/qa-quality
/.grok/

# Historical PR capture locations; upload review media to GitHub instead.
/docs/evidence/
/docs/screenshots/
/docs/images/
